# Every variable the UI reads. Copy to .env.local. See booking-system/CONFIG.md for the full table.
#
# NEXT_PUBLIC_* values are BAKED IN when the app is built and are visible to anyone who opens the
# site. Never put a secret in one, and changing one needs a rebuild/redeploy.

# --- Build-time and public (NEXT_PUBLIC_) ---

# Base URL of the backend API, no trailing slash. The app appends /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Not read by the code yet (added with error tracking).
# NEXT_PUBLIC_SENTRY_DSN=

# --- Server-only (never exposed to the browser) ---

# Not read by the code yet (added with error tracking). Build-time token for uploading source maps.
# SENTRY_AUTH_TOKEN=

# Set by GitHub Actions; read by playwright.config.ts. No need to set it yourself.
# CI=
